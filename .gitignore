# Backup files
*.bak
*.tmp

# Local secret config (sentry keys, etc.)
.env
.env.local
secret_*.cfg

# Asset pack download staging (zips not tracked, only README)
assets/_pack_downloads/*.zip
assets/_pack_downloads/*.7z
assets/_pack_downloads/*.rar

# Ruby
scripts/Gemfile.lock
scripts/.bundle/
scripts/vendor/bundle/

external/saves/save.json

# Local agent/runtime artifacts
.hermes/
__pycache__/
*.pyc
qa_logs/
qa_artifacts/
qa_gate1.log
qa_root.log

# Temporary generated backups
assets/generated/_backup_before_character_replace/

# 大型設計 mockup HTML（保留在磁碟當參考，不進 git 避免肥大）
docs/design/mockups/

# 美術重生 staging（AI 生成的中間產物、bakeoff、未 promote 的素材）
qa/art_regen/

# qa/ 工具：只追蹤 driver/scene/docs 原始碼；產出物（截圖/匯入/log/影片）不進 git
qa/**/*.png
qa/**/*.import
qa/**/*.webp
qa/**/*.jpg
qa/**/*.gif
qa/**/*.log
qa/**/*.txt
qa/**/*.apk
qa/**/*.idsig

# headless 測試/QA 產生的 log（非原始碼）
qa_*.log
