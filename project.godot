; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="鎮島錄"
config/name_localized={
"en": "Chronicles of the Island Ward",
"ja": "鎮島録",
"zh_CN": "镇岛录",
"zh_TW": "鎮島錄"
}
config/description="台灣民俗主題肉鴿卡牌戰鬥手機遊戲。Fork from Slay The Robot framework (MIT)."
run/main_scene="res://scenes/action/ActionStage.tscn"
config/features=PackedStringArray("4.4")
config/icon="uid://8kopj5luv8dc"
boot_splash/bg_color=Color(0.788, 0.125, 0.125, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true

[internationalization]

locale/translations=PackedStringArray("res://assets/translations/cotiw_main.zh_TW.translation", "res://assets/translations/cotiw_main.zh_CN.translation", "res://assets/translations/cotiw_main.en.translation", "res://assets/translations/cotiw_main.ja.translation")
locale/fallback="zh_TW"
locale/test="zh_TW"

[autoload]

Signals="*res://autoload/Signals.gd"
Scenes="*res://autoload/Scenes.gd"
Scripts="*res://autoload/Scripts.gd"
FileLoader="*res://autoload/FileLoader.gd"
Random="*res://autoload/Random.gd"
Global="*res://autoload/Global.gd"
ActionHandler="*res://autoload/ActionHandler.gd"
ActionGenerator="*res://autoload/ActionGenerator.gd"
DebugLogger="*res://autoload/DebugLogger.gd"
UIDGenerator="*res://autoload/UIDGenerator.gd"
Responsive="*res://autoload/Responsive.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1200
window/size/viewport_height=700
window/size/resizable=true
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/NotoSansTC-Regular.otf"

